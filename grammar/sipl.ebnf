(* SIPL: БНФ із практикуму з розставленими пріоритетами.
   Метазмінні: P - програма, S - оператор, a - вираз, b - умова *)

P   = "begin", S, "end" ;                          (* P1 *)

S   = S1, { ";", S1 } ;                            (* S2: послідовне виконання, ліва асоціативність *)
S1  = x, ":=", a                                   (* S1 *)
    | "if", b, "then", S1, "else", S1              (* S3 *)
    | "while", b, "do", S1                         (* S4 *)
    | "begin", S, "end"                            (* S5 *)
    | "skip" ;                                     (* S6 *)

a   = t, { ("+" | "-"), t } ;                      (* A3, A4 *)
t   = f, { "*", f } ;                              (* A5 *)
f   = n | x | "(", a, ")" ;                        (* A1, A2, A6 *)

b   = bn, { ("∨" | "or"), bn } ;                   (* B3 *)
bn  = ("¬" | "not"), bn | ba ;                     (* B4 *)
ba  = a, ("=" | ">"), a | "(", b, ")" ;            (* B1, B2, B5 *)

x   = letter, { letter | digit | "_" } ;           (* не ключове слово *)
n   = [ "-" ], digit, { digit } ;
